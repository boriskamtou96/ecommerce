PORT=8080
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SSLMODE=disable

# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_TOKEN_EXPIRES_IN=72h

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=ecommerce-uploads
# Leave empty to target real AWS S3
AWS_S3_ENDPOINT=http://localhost:4566

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760 # 10 MB
UPLOAD_PROVIDER=s3

# Public base URL of the CDN serving uploaded assets
CDN_BASE_URL=http://localhost:8081/uploads

# LocalStack Pro token (leave empty for the community image)
LOCALSTACK_AUTH_TOKEN=
